def npmCi = {
	sh '''
		docker run --rm \
			-v "$PWD/package.json:/app/package.json:ro" \
			-v "$PWD/package-lock.json:/app/package-lock.json:ro" \
			-v od-website-npm-cache:/root/.npm \
			-w /app \
			node:18 \
			npm ci
	'''
}

pipeline {
	agent any

	options {
		timeout(time: 2, unit: 'HOURS')
	}

	stages {
		stage('Pull Request Checks') {
			when {
				changeRequest()
			}

			steps {
				withChecks(name: 'npm ci') {
					script {
						npmCi()
					}
				}
			}
		}

		stage('Main Branch Checks') {
			when {
				allOf {
					branch 'main'
					not {
						changeRequest()
					}
				}
			}

			steps {
				withChecks(name: 'npm ci') {
					script {
						npmCi()
					}
				}
			}
		}
	}

	post {
		failure {
			emailext(
				from: 'jenkins@mail.onlinedi.vision',
				subject: "Build Failed: ${env.JOB_NAME} - ${env.BUILD_NUMBER}",
				body: "The build failed. Check the console output at ${env.BUILD_URL}.",
				to: 'TEAM@mail.onlinedi.vision'
			)
		}
	}
}
